    [40.3, 43.9, "А навстречу ему лиса."],
    [46.6, 49.6, "Колобок прыг лисе на язык…"],
    [49.6, 53.4, "…а лиса его — ам! — и съела."],
    [53.6, 59.0, "Тут и сказке конец, а кто слушал — молодец!"]
